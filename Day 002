//Problem Statement

You are given an array arr[] of non-negative integers. You have to move all the zeros in the array 
to the right end while maintaining the relative order of the non-zero elements. The operation must 
be performed in place, meaning you should not use extra space for another array.

//Solution

class Solution {
  public:
    void pushZerosToEnd(vector<int>& arr) {
        // code here
        int n=arr.size();
        int count=0;
        int temp=0;
        for(int i = 0; i<n;i++)
        {
            if(arr[i]!=0)
            {
                temp=arr[count];
                arr[count]=arr[i];
                arr[i]=temp;
                count++;
            }
        }
    }
};
